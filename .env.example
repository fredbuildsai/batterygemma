# Copy to .env and fill in. Never commit .env.

# Storage (SQLite now; Postgres/Supabase later, e.g. postgresql+psycopg://user:pass@host/db)
BG_DATABASE_URL=sqlite:///data/batterygemma.db

# Polite-crawling contact (sent in User-Agent to OpenAlex, Unpaywall, arXiv, ...)
BG_CONTACT_EMAIL=

# Router spend guard for paid models
BG_ALLOW_PAID=false
BG_MAX_USD_PER_DAY=5

# Teacher LLM providers (read by LiteLLM; leave blank to disable a provider)
GEMINI_API_KEY=
MISTRAL_API_KEY=
NVIDIA_NIM_API_KEY=
HF_TOKEN=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Data sources
CORE_API_KEY=
MP_API_KEY=
